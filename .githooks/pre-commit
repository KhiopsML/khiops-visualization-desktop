#!/bin/sh

# Prevent committing dist paths from khiops-visualization in angular.json
if git diff --cached -- angular.json | grep -q '"\.\./khiops-visualization/dist/'; then
  echo ""
  echo "❌ Commit blocked: angular.json contains a reference to ../khiops-visualization/dist/"
  echo "   Remove the dist path from 'scripts' before committing."
  echo ""
  exit 1
fi

exit 0